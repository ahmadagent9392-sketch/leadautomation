{
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(./.env)",
      "Edit(./.claude/hooks/guard.py)",
      "Write(./.claude/hooks/guard.py)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "mcp__claude_ai_Gmail__reply"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(pip install:*)",
      "Bash(npm install:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
