# Copy to .env (never commit .env)
# Database (Stage 2). Supabase -> Project Settings -> API. Use the SECRET key. Never share it.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# supabase (default) or sqlite (local file data/desk.db, no internet)
DESK_BACKEND=
PAGESPEED_API_KEY=
# Stage 7: Google Places API (New), only for reviews. Google Cloud -> enable "Places API (New)" -> API key.
GOOGLE_PLACES_API_KEY=
HUNTER_API_KEY=
